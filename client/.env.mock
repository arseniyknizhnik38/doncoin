# Режим локальной отладки Telegram-интерфейса без туннеля:
#   npm run dev:mock
# Подставляет фиктивное окружение Telegram (см. src/telegram/mockEnv.ts).
# Секретов не содержит, коммитится намеренно.
VITE_TG_MOCK=1

# Фиктивный токен для подписи мок-данных. Должен совпадать с server/.env.mock,
# иначе сервер отвергнет подпись. Настоящий токен бота сюда класть НЕЛЬЗЯ.
VITE_TG_MOCK_BOT_TOKEN=123456:TEST_ONLY_NOT_A_REAL_TOKEN
