# Скопируйте этот файл в server/.env и подставьте реальные значения.

# Строка подключения PostgreSQL (например, из Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=verify-full"

# Порт, на котором слушает Express API (клиентский dev-прокси ожидает 3000)
PORT=3000

# Токен бота из @BotFather. Как получить — см. README, раздел «Telegram Mini App».
# Пока пусто — POST /api/auth/telegram отвечает 503.
TELEGRAM_BOT_TOKEN=""

# Кому доступна сводка (/api/admin/stats) — Telegram ID через запятую.
# Пусто = никому.
ADMIN_TELEGRAM_IDS="123456789"

# Секрет для планировщика (/api/cron/notify). Должен совпадать с секретом
# репозитория CRON_SECRET в GitHub Actions.
CRON_SECRET="__ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ__"

# --- Рекламные конверсии (postback) ---

# Адрес postback рекламной сети. Шаблон берётся из кабинета рекламодателя
# как есть; код лишь подставляет значения. Доступные подстановки:
# {click_id} {source} {placement} {campaign} {user_id} {event} {value}
# Пусто — конверсии считаются и пишутся в журнал, но наружу не уходят.
#
# Для AdsGram (токен из их кабинета, профиль в правом верхнем углу;
# goaltype: 1 — регистрация, 2 — первая покупка, 3 — повторная):
# AD_POSTBACK_URL="https://api.adsgram.ai/confirm_conversion?token=ТОКЕН&tgid={user_id}&goaltype=1&campaignid={campaign}"
AD_POSTBACK_URL=""

# Две опорные точки «telegram id : дата» для оценки возраста аккаунта.
# По ним отсекаются свежие аккаунты ботоферм. Пусто — проверка не применяется.
AD_ID_ANCHORS="1000000000:2020-11-01,7000000000:2024-01-01"

# Соль для отпечатка IP в журнале конверсий. Пусто — берётся CRON_SECRET.
AD_IP_SALT=""
