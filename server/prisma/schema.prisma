// Prisma schema for DONCOIN
// Docs: https://pris.ly/d/prisma-schema
//
// The connection string is NOT read from this file in Prisma 7 —
// it comes from `prisma.config.ts`, which loads DATABASE_URL from server/.env

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  telegramId String   @unique
  username   String?
  firstName  String?

  /// Язык интерфейса: «ru» или «en».
  ///
  /// Берётся из настроек Telegram при первом входе и дальше сам не меняется:
  /// человек, сменивший язык телефона в поездке, не должен обнаружить игру
  /// на другом языке.
  language String @default("ru")

  /// Собственный код приглашения, попадает в ссылку ?startapp=КОД
  referralCode String @unique

  /// start_param из реферальной ссылки, записывается один раз при создании
  referredByCode String?

  /// Кто пригласил — связь, разобранная из referredByCode при регистрации
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("Referrals")

  /// Сколько монет получено с приглашённых
  referralEarned BigInt @default(0)

  /// Заплачено ли пригласившему за этого игрока.
  ///
  /// Награда выдаётся не при регистрации, а когда приглашённый докажет, что
  /// играет (REFERRAL_QUALIFY_TAPS тапов). Иначе монеты чеканятся скриптом:
  /// достаточно открыть приложение с чужим кодом столько раз, сколько
  /// хватит терпения завести аккаунтов.
  referralRewarded Boolean @default(false)
  /// Игровой баланс. BigInt — чтобы не упереться в потолок Int при апгрейдах.
  balance BigInt @default(0)

  /// Сколько монет заработано за всё время. Только растёт, тратами не
  /// уменьшается — на нём строятся ранги, иначе покупка апгрейда или взнос
  /// в клан понижали бы статус игрока.
  totalEarned BigInt @default(0)

  /// Энергия: тратится на тапы и восстанавливается со временем.
  ///
  /// Хранится в долях тапа: один тап стоит ENERGY_PER_TAP = 10 единиц
  /// (server/src/lib/energy.ts). Иначе медленный реген в Int не выразить.
  /// Стартовые значения дублируют нулевые уровни каталога улучшений
  /// (START_STATE в lib/upgrades.ts) — там источник правды, здесь запасной
  /// вариант для строк, созданных мимо createUser.
  energy          Int      @default(6000)
  energyMax       Int      @default(6000)
  energyPerSecond Int      @default(1)
  /// Момент последнего пересчёта энергии; служит и меткой версии при записи.
  energyUpdatedAt DateTime @default(now())

  /// Сколько монет даёт один тап. Пересчитывается при покупке апгрейда.
  coinsPerTap Int @default(10)

  /// Repect — медленная «репутационная» валюта: +1 за каждые N тапов.
  respect Int @default(0)
  /// Тапы, накопленные в счёт следующей единицы Respect (остаток от деления).
  respectProgress Int @default(0)
  /// Потрачено Respect за всё время — сам respect тратами не уменьшается,
  /// иначе он перестал бы отражать вложенный труд.
  respectSpent Int @default(0)

  /// Уровни, купленные за Respect. Дают постоянные прибавки к доходу.
  respectStreetLevel   Int @default(0)
  respectBusinessLevel Int @default(0)
  respectFamilyLevel   Int @default(0)

  /// Купленные уровни улучшений. Рабочие значения выше выводятся из них
  /// формулами из server/src/lib/upgrades.ts.
  tapLevel    Int @default(0)
  energyLevel Int @default(0)
  regenLevel  Int @default(0)

  /// Когда игрок последний раз что-то делал. От этого считается
  /// оффлайн-доход, поэтому обновляется и при входе, и при тапах.
  lastSeenAt DateTime @default(now())

  /// Идентификаторы полученных заданий. Прогресс не храним — он выводится
  /// из остальных полей (тапы, заработок, уровни, рефералы, клан).
  claimedTasks String[] @default([])

  /// Сколько раз игрок уходил на покой. Каждый уход даёт постоянную
  /// прибавку к доходу — это единственное, ради чего стоит начинать заново.
  retirements Int @default(0)

  /// Заработано за всё время, включая прошлые круги. В отличие от
  /// totalEarned, уходом на покой не обнуляется: иначе лидерборд выбрасывал
  /// бы на дно ровно тех, кто прошёл игру до конца.
  lifetimeEarned BigInt @default(0)

  /// Ежедневный бонус: длина серии и время последнего получения.
  dailyStreak Int       @default(0)
  lastDailyAt DateTime?

  /// Бустеры. Счётчики обнуляются, когда boostDay отстаёт от текущих суток
  /// (UTC) — отдельная фоновая задача для сброса не нужна.
  boostDay       Int       @default(0)
  fullEnergyUsed Int       @default(0)
  rushUsed       Int       @default(0)
  /// Пока не истекло — каждый тап стоит столько же, а даёт кратно больше.
  rushEndsAt     DateTime?

  /// О какой ступени ранга уже объявляли в ленте.
  ///
  /// Ранг нигде не хранится — он считается от заработка, и «момента
  /// повышения» в базе нет. Чтобы не объявлять одно и то же при каждом
  /// заходе, запоминаем последнюю объявленную ступень.
  feedRankStep Int @default(0)

  /// Когда игрок последний раз получал конверт, и что в нём было.
  ///
  /// Номер суток UTC, как у бонуса и заданий: отдельной фоновой задачи для
  /// сброса не нужно. Ступень и сумма хранятся, чтобы показать результат
  /// ещё раз, если игрок закрыл приложение сразу после открытия.
  envelopeDay    Int     @default(0)
  envelopeTier   String?
  envelopeAmount BigInt  @default(0)

  /// Попытки угадать шифр дня. Обнуляются вместе со сменой cipherDay —
  /// тем же приёмом, что и заряды бустеров, без фоновой задачи.
  ///
  /// Без ограничения код длиной в шесть букв подбирается перебором за
  /// вечер, и весь смысл шифра — привести человека в канал — пропадает.
  cipherDay      Int @default(0)
  cipherAttempts Int @default(0)

  /// Прогресс по заданиям дня и разгаданные шифры.
  questDays     DailyQuestDay[]
  cipherSolves  CipherSolve[]

  /// Дни, когда игрок заходил — по ним считается удержание.
  activeDays    DailyActive[]

  /// Купленные фоны и тот, что выбран сейчас.
  ///
  /// null — показывается фон своего ранга. Хранится идентификатор из
  /// каталога, а не ссылка на таблицу: каталог живёт в коде, и добавление
  /// фона не должно требовать миграции.
  equippedBackdrop String?
  backdrops        BackdropPurchase[]

  /// Уведомления от бота: игрок может их отключить, а бот — узнать, что
  /// его заблокировали, и перестать писать.
  notificationsEnabled Boolean   @default(true)
  notificationsBlocked Boolean   @default(false)
  lastNotifiedAt       DateTime?

  /// «Кента подозревают»: когда бот последний раз написал приглашённому,
  /// что его приняли за стукача, и ждёт ли куш его возвращения.
  snitchCalledAt DateTime?
  snitchPending  Boolean   @default(false)

  /// Выполненные еженедельные поручения.
  favorCompletions FavorCompletion[]

  /// Бизнесы игрока и момент последнего начисления дохода с них.
  businesses          UserBusiness[]
  businessCollectedAt DateTime      @default(now())

  /// Клан игрока и его вклад в общую казну.
  clanId          String?
  clan            Clan?     @relation("ClanMembers", fields: [clanId], references: [id], onDelete: SetNull)
  clanJoinedAt    DateTime?
  clanContributed BigInt    @default(0)

  /// Клан, которым игрок владеет (у клана ровно один владелец).
  ownedClan Clan? @relation("ClanOwner")

  /// Участие в клановых войнах.
  warEntries ClanWarEntry[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Лидерборд сортирует и считает позицию по этому полю.
  @@index([lifetimeEarned])
  @@index([totalEarned])
}

/// Еженедельное рекламное поручение: подписаться на канал.
/// Рекламная кампания: «подпишись на канал — получи монеты».
///
/// На этом игра зарабатывает, поэтому кампании заводятся через админку, а не
/// правкой кода: рекламодатель не должен ждать деплоя. Раньше каталог лежал
/// в config/favors.ts и заливался seed-скриптом — добавить клиента можно было
/// только коммитом.
model Favor {
  id String @id @default(uuid())

  /// Осталось от недельных поручений. У кампаний, заведённых через админку,
  /// здесь 0: срок теперь задают startsAt и endsAt, а не номер недели.
  weekNumber Int @default(0)

  /// Кто купил размещение — для отчётности, игроку не показывается.
  advertiser String?

  title       String
  channelName String
  channelUrl  String
  /// Технический ID канала в Telegram — по нему проверяется подписка.
  channelChatId String

  /// Фиксированная награда. Используется, если не задан rewardHours.
  rewardDonc     BigInt
  /// Награда в часах активного дохода игрока. Так она не обесценивается
  /// к «Капо»: фиксированная сумма, щедрая на старте, к середине игры
  /// перестаёт быть поводом подписываться.
  rewardHours    Float?
  familyXpReward Int

  /// Срок размещения. null с обеих сторон — кампания без срока.
  startsAt DateTime?
  endsAt   DateTime?

  /// Сколько подписок куплено. null — без ограничения.
  slots Int?
  /// Сколько уже выдано. Считается здесь, а не запросом по completions:
  /// лимит проверяется в том же UPDATE, что и выдача награды.
  completedCount Int @default(0)

  /// Чем меньше, тем выше в списке.
  sortOrder Int @default(0)

  active Boolean @default(true)

  completions FavorCompletion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один активный заказ на канал: две кампании на один и тот же канал
  /// одновременно бессмысленны — подписка-то одна.
  @@unique([weekNumber, channelName])
  @@index([active, sortOrder])
}

/// Отметка о выполнении поручения игроком.
model FavorCompletion {
  id String @id @default(uuid())

  userId  String
  favorId String

  completedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  favor Favor @relation(fields: [favorId], references: [id], onDelete: Cascade)

  /// Одно выполнение на игрока — защита от повторного начисления.
  @@unique([userId, favorId])
  @@index([userId])
}

/// Каталог бизнесов — общий для всех, наполняется seed-скриптом.
model Business {
  id   String @id @default(uuid())
  /// Устойчивый ключ: по нему seed обновляет запись, не плодя дубли.
  slug String @unique

  name        String
  description String
  category    String

  baseCost          BigInt
  baseIncomePerHour BigInt
  /// Во сколько раз дорожает каждый следующий уровень.
  costMultiplier Float @default(1.15)

  /// Порядок в каталоге — от дешёвых к дорогим.
  sortOrder Int @default(0)

  owners UserBusiness[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// Уровень конкретного бизнеса у конкретного игрока. 0 — не куплен.
model UserBusiness {
  id String @id @default(uuid())

  userId     String
  businessId String

  level       Int      @default(0)
  purchasedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([userId, businessId])
  @@index([userId])
}

model Clan {
  id   String @id @default(uuid())
  name String @unique

  /// Общая казна, пополняется взносами участников.
  treasury BigInt @default(0)

  /// Какую долю дохода с бизнесов участники отстёгивают в кассу, в процентах.
  ///
  /// Ставку задаёт глава, но не любую: потолок в коде. Глава, поставивший
  /// девяносто процентов, разогнал бы семью за вечер — и это была бы уже не
  /// механика привязки, а способ её разрушить.
  tributePercent Int @default(10)

  /// Опыт семьи: копится за выполненные поручения (favors) участников.
  familyXp Int @default(0)

  ownerId String @unique
  owner   User   @relation("ClanOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members User[] @relation("ClanMembers")

  /// Войны семьи: пара составляется раз в неделю, стороны A и B равноправны.
  warsAsA ClanWar[] @relation("WarsAsA")
  warsAsB ClanWar[] @relation("WarsAsB")
  warsWon ClanWar[] @relation("WarsWon")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([treasury])
}

/// Клановая война: две семьи меряются заработком за неделю.
///
/// Счёт НЕ пишется при каждом тапе — на старте войны снимается слепок
/// totalEarned каждого участника, а текущий счёт выводится вычитанием.
/// Так война ничего не стоит на горячем пути и не может разойтись с балансом.
model ClanWar {
  id String @id @default(uuid())

  /// Номер недели в формате ГОД*100 + номер по ISO — тот же, что у поручений.
  weekNumber Int

  clanAId String
  clanA   Clan   @relation("WarsAsA", fields: [clanAId], references: [id], onDelete: Cascade)
  clanBId String
  clanB   Clan   @relation("WarsAsB", fields: [clanBId], references: [id], onDelete: Cascade)

  startedAt DateTime @default(now())
  endsAt    DateTime

  /// active — идёт, finished — подведены итоги.
  status String @default("active")

  /// Итоговый счёт, заполняется при закрытии.
  scoreA BigInt @default(0)
  scoreB BigInt @default(0)

  winnerId String?
  winner   Clan?   @relation("WarsWon", fields: [winnerId], references: [id], onDelete: SetNull)

  /// Сколько монет ушло из казны проигравшего победителю.
  potPaid    BigInt    @default(0)
  finishedAt DateTime?

  entries ClanWarEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один клан — одна война в неделю, с любой стороны пары.
  @@unique([weekNumber, clanAId])
  @@unique([weekNumber, clanBId])
  @@index([status, endsAt])
}

/// Участие игрока в войне и его слепок заработка.
model ClanWarEntry {
  id String @id @default(uuid())

  warId String
  war   ClanWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  /// За какой клан игрок воюет — фиксируется, чтобы переход не переносил вклад.
  clanId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// totalEarned на момент вступления в войну.
  startTotal BigInt

  /// Замороженный вклад: проставляется при выходе из клана и при закрытии
  /// войны. Пока null — вклад считается на лету от текущего totalEarned.
  frozenEarned BigInt?

  createdAt DateTime @default(now())

  @@unique([warId, userId])
  @@index([warId, clanId])
}

/// Задания дня: три штуки, новые каждые сутки.
///
/// Прогресс нигде не накапливается по событиям — он считается как разница
/// между текущими показателями игрока и слепком, снятым при выдаче заданий.
/// Так тап остаётся одним UPDATE, а не превращается в запись ещё и сюда.
model DailyQuestDay {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Номер суток UTC — тот же, что у ежедневного бонуса.
  dayNumber Int

  /// Какие три задания выпали. Храним выбор, а не пересчитываем: иначе
  /// правка каталога среди дня подменяла бы игроку задания на ходу.
  quests String[]

  /// Слепок показателей на момент выдачи.
  baseTaps      Int    @default(0)
  baseEarned    BigInt @default(0)
  baseUpgrades  Int    @default(0)
  baseBusiness  Int    @default(0)
  baseDonated   BigInt @default(0)

  /// Что уже забрано, и забран ли сундук за все три.
  claimed      String[] @default([])
  chestClaimed Boolean  @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, dayNumber])
  @@index([dayNumber])
}

/// Шифр дня: код прячется в канале, вводится в игре.
///
/// Главный смысл — не награда, а то, что игра начинает кормить канал:
/// за кодом нужно идти туда, где живёт аудитория.
model DailyCipher {
  id String @id @default(uuid())

  /// Номер суток UTC, на которые действует шифр.
  dayNumber Int    @unique
  /// Хранится в верхнем регистре — сравнение регистронезависимо.
  code      String
  /// Подсказка, где искать: показывается игроку до разгадки.
  hint      String?

  solves CipherSolve[]

  createdAt DateTime @default(now())
}

/// Отметка, что игрок разгадал шифр. Награда выдаётся ровно один раз.
model CipherSolve {
  id       String      @id @default(uuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cipherId String
  cipher   DailyCipher @relation(fields: [cipherId], references: [id], onDelete: Cascade)

  reward   BigInt   @default(0)
  solvedAt DateTime @default(now())

  @@unique([userId, cipherId])
}

/// Отметка «игрок заходил в этот день».
///
/// Нужна для удержания: по одному полю lastSeenAt нельзя узнать, заходил ли
/// человек на третий день после регистрации, — оно хранит только последний
/// раз. А удержание второго и седьмого дня это и есть главный вопрос к
/// игре такого жанра.
///
/// Запись идёт не чаще раза в сутки на игрока: при входе сравнивается день
/// прошлого визита с сегодняшним, и если он тот же, в базу никто не ходит.
model DailyActive {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Номер суток UTC — тот же, что у ежедневного бонуса и заданий.
  dayNumber Int

  @@unique([userId, dayNumber])
  @@index([dayNumber])
}

/// Купленный фон.
///
/// Фоны — первая трата в игре, которая не возвращает деньги. Улучшения,
/// бизнесы и перки увеличивают доход, поэтому к середине игры баланс растёт
/// быстрее, чем находится, на что его деть. Здесь монеты исчезают насовсем,
/// а взамен остаётся то, что видно на экране.
model BackdropPurchase {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Идентификатор из каталога (server/src/config/backdrops.ts).
  backdropId String

  price     BigInt   @default(0)
  boughtAt  DateTime @default(now())

  @@unique([userId, backdropId])
}

/// Событие в ленте «Что слышно».
///
/// Лента в основном про семьи: кто с кем сошёлся, кто набрал силу, кто
/// заявил о себе. Про отдельных игроков — только то, чему завидуют: высокий
/// ранг, уход на покой, толстый конверт. Лента из «такой-то заработал пять
/// сотен» — это шум, а не новости, и читать её перестают на второй день.
///
/// Имена хранятся строками, а не ссылками на игрока и семью: событие должно
/// пережить и переименование семьи, и её роспуск. Новость «Корлеоне взяли с
/// Траттории» остаётся правдой, даже когда Траттории уже нет.
model FeedEvent {
  id   String @id @default(uuid())
  kind String

  /// Кто в главной роли: имя игрока или название семьи.
  actor String
  /// Вторая сторона, если есть: соперник в войне.
  rival String?
  /// Сумма или уровень — смысл зависит от kind.
  amount BigInt?
  /// Подпись ранга для событий про игроков.
  rank   String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}
